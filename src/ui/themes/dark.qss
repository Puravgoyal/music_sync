/* WiZ Music Sync — Modern Dark Theme Stylesheet */

QWidget {
    background-color: #121316;
    color: #e2e8f0;
    font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
    font-size: 13px;
}

QGroupBox {
    background-color: #18191d;
    border: 1px solid #28292e;
    border-radius: 8px;
    margin-top: 18px;
    padding: 14px 12px 12px 12px;
    font-weight: 600;
    font-size: 13px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 8px;
    color: #94a3b8;
    background-color: #18191d;
    border: 1px solid #28292e;
    border-radius: 4px;
}

QLabel {
    color: #cbd5e1;
}

QLabel#headingLabel {
    font-size: 18px;
    font-weight: 700;
    color: #f8fafc;
}

QLabel#subheadingLabel {
    font-size: 12px;
    color: #64748b;
}

QPushButton {
    background-color: #24262c;
    color: #f1f5f9;
    border: 1px solid #383a42;
    border-radius: 6px;
    padding: 7px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #2d3037;
    border-color: #4b4e58;
}

QPushButton:pressed {
    background-color: #1c1d22;
}

QPushButton:disabled {
    background-color: #15161a;
    color: #475569;
    border-color: #1f2025;
}

QPushButton#primaryButton {
    background-color: #4f46e5;
    color: #ffffff;
    border: 1px solid #6366f1;
}

QPushButton#primaryButton:hover {
    background-color: #4338ca;
}

QPushButton#startSyncButton {
    background-color: #059669;
    color: #ffffff;
    border: 1px solid #10b981;
    font-size: 14px;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 8px;
}

QPushButton#startSyncButton:hover {
    background-color: #047857;
}

QPushButton#stopSyncButton {
    background-color: #dc2626;
    color: #ffffff;
    border: 1px solid #ef4444;
    font-size: 14px;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 8px;
}

QPushButton#stopSyncButton:hover {
    background-color: #b91c1c;
}

QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #18191d;
    border: 1px solid #2d2f36;
    border-radius: 6px;
    padding: 6px 10px;
    color: #f8fafc;
    selection-background-color: #4f46e5;
}

QComboBox:focus, QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #6366f1;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #2d2f36;
}

QComboBox QAbstractItemView {
    background-color: #18191d;
    border: 1px solid #2d2f36;
    selection-background-color: #4f46e5;
    selection-color: #ffffff;
    color: #f8fafc;
    padding: 4px;
}

QSlider::groove:horizontal {
    border: 1px solid #28292e;
    height: 6px;
    background: #1e2025;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #6366f1;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #e2e8f0;
    border: 1px solid #475569;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #ffffff;
    border-color: #6366f1;
}

QProgressBar {
    background-color: #18191d;
    border: 1px solid #28292e;
    border-radius: 5px;
    text-align: center;
    color: #94a3b8;
    font-size: 11px;
    font-weight: 600;
}

QProgressBar::chunk {
    background-color: #6366f1;
    border-radius: 4px;
}

QStatusBar {
    background-color: #101114;
    border-top: 1px solid #1f2025;
    color: #94a3b8;
    font-size: 12px;
}

QCheckBox {
    spacing: 8px;
    color: #cbd5e1;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #33363f;
    border-radius: 4px;
    background-color: #18191d;
}

QCheckBox::indicator:checked {
    background-color: #4f46e5;
    border-color: #6366f1;
}
